<?xml version="1.0" encoding="utf-8"?>
<!--
  AOSP settingslib_round_background_top (v35):
  solid = preference 项背景 SurfaceContainerLowest
  top radius = 20dp, bottom = 4dp
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerLowest" />
            <corners
                android:topLeftRadius="@dimen/preference_corner_radius"
                android:topRightRadius="@dimen/preference_corner_radius"
                android:bottomLeftRadius="@dimen/preference_inner_corner_radius"
                android:bottomRightRadius="@dimen/preference_inner_corner_radius" />
        </shape>
    </item>
</ripple>
